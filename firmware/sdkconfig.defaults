# Target: EasyInput V2.0 / ESP32-S3R8
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# 「四固件一键切换」统一 6 槽分区表（本工程 = ota_3 电子琴）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Companion UI talks Web Serial on the same USB-Serial/JTAG pipe as the console.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=y

# ★ 蓝牙链路（BLE NUS）：网页端可不插数据线就控制板子（Web Bluetooth）。
#   走 NimBLE（比 Bluedroid 省 flash/RAM）；角色只要外设（Peripheral）。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Keep USB Serial mostly for host JSON frames (UI ignores non-JSON lines).
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

